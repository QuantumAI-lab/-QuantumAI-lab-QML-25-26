      "seed": 1587912222,
      "version": 263,
      "versionNonce": 245607582,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766853543503,
      "link": null,
      "locked": false,
      "text": "At the beginning, we apply Hadamard operators to all qubits\n=> All amplitudes are 1/sqrt(N) => Same amplitude, and as the game\niterates, amplitudes change ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At the beginning, we apply Hadamard operators to all qubits\n=> All amplitudes are 1/sqrt(N) => Same amplitude, and as the game\niterates, amplitudes change ",
      "autoResize": true,
      "lineHeight": 1.25
    },
