      "boundElements": [],
      "updated": 1766853283642,
      "link": null,
      "locked": false,
      "text": "*Oracle: A \"blackbox\" that performs a certain computation\n          From a conceptor point of view: it is understood\n          From an executor point of view: it's structure is ambiguous BUT we can query it and get a result \n                                                  out of it ",
      "fontSize": 44.32564362046029,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*Oracle: A \"blackbox\" that performs a certain computation\n          From a conceptor point of view: it is understood\n          From an executor point of view: it's structure is ambiguous BUT we can query it and get a result \n                                                  out of it ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r1RNAag_ySVkFwRwHs_Si",
      "type": "text",
      "x": 890.3292892648209,
      "y": 601.3206990452464,
      "width": 1340.0519435009219,
      "height": 277.0352726278768,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0ae",
      "roundness": null,
      "seed": 1887846246,
      "version": 502,
      "versionNonce": 275148126,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766853283642,
      "link": null,
      "locked": false,
      "text": "   Oracles are UNITARY OPERATORS (UU =U U=I)\n   because they are composed of quantum gates (unitary and \n   reversible)\n   \n   It can perform computation or mark a correct answer.",
      "fontSize": 44.32564362046029,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   Oracles are UNITARY OPERATORS (UU =U U=I)\n   because they are composed of quantum gates (unitary and \n   reversible)\n   \n   It can perform computation or mark a correct answer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
