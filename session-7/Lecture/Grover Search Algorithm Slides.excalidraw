      "boundElements": [],
      "updated": 1766866531856,
      "link": null,
      "locked": false,
      "text": "=> 0 iteration: θ \n    1 iteration: 3θ\n    2 iteration: 5θ\n    ...\n    n iteration: (2n+1)θ \n\nWe want (2n+1)θ as close to pi/2 as possible\n                             We know θ= 1/sqrt(N)",
      "fontSize": 51.275082421774314,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> 0 iteration: θ \n    1 iteration: 3θ\n    2 iteration: 5θ\n    ...\n    n iteration: (2n+1)θ \n\nWe want (2n+1)θ as close to pi/2 as possible\n                             We know θ= 1/sqrt(N)",
      "autoResize": true,
      "lineHeight": 1.25
    },
