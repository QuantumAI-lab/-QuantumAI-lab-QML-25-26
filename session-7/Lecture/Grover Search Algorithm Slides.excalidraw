    {
      "id": "B_biEEh4FZOG7fJfzSl6Q",
      "type": "text",
      "x": -124.57121402434535,
      "y": 16855.90263706053,
      "width": 1617.413037903292,
      "height": 517.1090464391224,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0qT",
      "roundness": null,
      "seed": 1954882746,
      "version": 722,
      "versionNonce": 126946562,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766853283643,
      "link": null,
      "locked": false,
      "text": "Problem: Searching through a list for a defined item\n\nClassically: If our list is sorted we can use binary search\n              => Each time we \"Query\" our list, we divide it by two\n              => O(lon2(N)) complexity \n              If our list is unsorted => O(N)\n\nGrover's algorithm:",
      "fontSize": 51.710904643912244,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem: Searching through a list for a defined item\n\nClassically: If our list is sorted we can use binary search\n              => Each time we \"Query\" our list, we divide it by two\n              => O(lon2(N)) complexity \n              If our list is unsorted => O(N)\n\nGrover's algorithm:",
      "autoResize": true,
      "lineHeight": 1.25
    },
